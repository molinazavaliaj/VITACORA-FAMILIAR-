# Copiar a .env y completar. Lo carga Naza a mano; nunca se commitea.
SUPABASE_URL=https://ctjvwipakebupscsfyaw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Whisper, para ubicar cada frase en el audio de su respuesta (la misma clave del entrevistador).
OPENAI_API_KEY=
# Dónde baja el modelo de restauración sus pesos.
CARPETA_MODELOS=D:\vitacora-modelos
# Temporales: los wav intermedios de cada frase.
CARPETA_TRABAJO=C:\vitacora-voz\prueba
INTERVALO_SEGUNDOS=30
# Restauración de los audios originales con resemble-enhance, 0..1: la fuerza del
# modelo (0 = no se toca). Al 100 % la voz puede "temblar". Default 0,7.
# RESTAURACION_NIVEL=0.7
# MOTOR ya no hace falta (el audiolibro con voz clonada se sacó el 16/10/2026).
# Si quedó en un .env viejo, junto con PAUSAS_MS, TRAMOS o RITMO, no molesta: se ignora.
