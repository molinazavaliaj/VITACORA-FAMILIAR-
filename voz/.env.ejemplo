# Copiar a .env y completar. Lo carga Naza a mano; nunca se commitea.
SUPABASE_URL=https://ctjvwipakebupscsfyaw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Solo para transcribir la referencia si no hay una respuesta entera de 12-30 s (la misma clave del entrevistador).
OPENAI_API_KEY=
CARPETA_MODELOS=D:\vitacora-modelos
CARPETA_TRABAJO=C:\vitacora-voz\prueba
# El ganador de la prueba de oído: chatterbox | qwen3tts | f5tts | omnivoice. Solo lo usa el worker.
MOTOR=
INTERVALO_SEGUNDOS=30
# Pausas del audiolibro en ms (voz/pausas.py). Solo hace falta nombrar las que se cambian.
# PAUSAS_MS=coma=250,punto=500,suspensivos=700,parrafo=1000,historia=1200
# Cómo se corta el texto para el motor: oracion (un tramo por oración; las comas las pausa el
# motor y se igualan a `coma` ms) o coma (también se corta en comas). Elegido por oído: oracion.
# TRAMOS=oracion
# Restauración de los audios originales con resemble-enhance (directiva 02), 0..1:
# 0 = no se toca, 1 = todo restaurado. Al 100 % la voz puede "temblar"; 0,7 la fuerza de la restauración (0 = no tocar; ya no mezcla con el original).
# RESTAURACION_NIVEL=0.7
# RITMO=0 apaga los cortes de ritmo (arranques que responden a la pregunta, silencios largos). Default: activo.
# RITMO=1
