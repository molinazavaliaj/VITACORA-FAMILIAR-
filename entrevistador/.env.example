# Supabase (compartidas — las pasa Naza; proyecto único del monorepo)
SUPABASE_URL=https://ctjvwipakebupscsfyaw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# IA
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# WhatsApp Cloud API (Meta for Developers)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
# App Secret de la app de Meta (Configuración de la app > Básica). Con él se comprueba la firma de cada mensaje.
WA_APP_SECRET=
# 1 cuando la plantilla `bienvenida` aprobada en Meta ya lleva la frase que pide
# permiso para clonar la voz (PLANTILLAS.md). Hasta entonces el SÍ no anota
# consentimiento_voz_at y el permiso se carga a mano (manual -- ficha --voz-si).
WA_BIENVENIDA_PIDE_VOZ=0

# Puerto del servidor (opcional, default 3001).
# En Railway NO hace falta: la plataforma inyecta PORT y tiene prioridad.
PUERTO=3001

# Quién paga la key de IA de este servicio (naza | joaquin). Se anota en consumo_ia.
CUENTA_IA=naza

# Entrevista V3 (spec 2026-10-07)
# Mails de aviso a los socios (separados por coma). Sin esto, los avisos quedan en la consola.
MAIL_SOCIOS=
# 1 = los narradores nuevos entran a la V3 al pasar a activo. APAGADO hasta que Naza diga.
V3_PARA_NUEVOS=
# 0 = apaga el cazador de escenas (Opus 5.5, tope USD 3 por entrevista). Vacío = prendido.
V3_CAZADOR=
# Plantillas de Meta aprobadas para la V3, como idioma:tipo separados por coma
# (ej. "es-AR:recordatorio,ca:pregunta,ca:recordatorio"; "recordatorio" = la plantilla con el texto de M8).
# es-AR:pregunta (pregunta_diaria_vos) va siempre. Los nombres están en PLANTILLAS_V3 (src/config.ts).
WA_PLANTILLAS_V3_LISTAS=

# Vitácora de Viaje (solo V2 desde el 16/10/2026: el bot da el alta solo a cada viajero nuevo)
# Plantillas de Meta aprobadas para la Viaje V2, como idioma:tipo separados por coma
# (ej. "es-AR:bienvenida,es-AR:mensaje,es-AR:recordatorio"). Los nombres están en PLANTILLAS_VIAJE_V2 (src/config.ts).
WA_PLANTILLAS_VIAJE_V2_LISTAS=
